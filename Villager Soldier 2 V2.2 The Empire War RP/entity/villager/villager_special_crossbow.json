{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "fv:villager_special_crossbow",
			"materials": {
				"default": "pillager"
			},
			"textures": {
				"desert": "textures/entity/villager_guard_sword/desert",
				"jungle": "textures/entity/villager_guard_sword/jungle",
				"plains": "textures/entity/villager_guard_sword/plains",
				"savanna": "textures/entity/villager_guard_sword/savanna",
				"snow": "textures/entity/villager_guard_sword/snow",
				"swamp": "textures/entity/villager_guard_sword/swamp",
				"taiga": "textures/entity/villager_guard_sword/taiga",
				"armor": "textures/entity/villager_special_armor/special2",
				"cape": "textures/entity/villager_guard_sword/special_cape"
			},
			"geometry": {
				"default": "geometry.revillager",
				"armor": "geometry.villager_special_armor",
				"cape": "geometry.cape_illager"
			},
			"spawn_egg": {
				"base_color": "#62799d",
				"overlay_color": "#798ba7"
			},
			"scripts": {
				"scale": "0.9375",
				"pre_animation": [
					"variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
				],
				"animate": [
					"pillager_root_controller",
					"cape",
					"controllercaperun",
					{
						"controller_crossbow_attack": "query.variant==1"
					},
					{
						"controller_gun_attack": "query.variant==2"
					}
				]
			},
			"animations": {
				"humanoid_base_pose": "animation.humanoid.base_pose",
				"look_at_target_default": "animation.humanoid.look_at_target.default",
				"look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
				"look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
				"move": "animation.humanoid.move",
				"riding.arms": "animation.humanoid.riding.arms",
				"riding.legs": "animation.humanoid.riding.legs",
				"holding": "animation.humanoid.holding",
				"attack.rotations": "animation.humanoid.attack.rotations",
				"bob": "animation.humanoid.bob",
				"crossbow_hold": "animation.pillager.crossbow.hold",
				"crossbow_charge": "animation.pillager.crossbow.charge",
				"celebrating": "animation.humanoid.celebrating",
				"controller_humanoid_base_pose": "controller.animation.humanoid.base_pose",
				"controller_look_at_target": "controller.animation.humanoid.look_at_target",
				"controller_move": "controller.animation.humanoid.move",
				"controller_riding": "controller.animation.humanoid.riding",
				"controller_attack": "controller.animation.humanoid.attack",
				"controller_bob": "controller.animation.humanoid.bob",
				"controller_crossbow_attack": "controller.animation.pillager.attack",
				"controller_gun_attack": "controller.animation.gun.attack",
				"pillager_root_controller": "controller.animation.pillager.root",
				"cape": "animation.cape_illager.moving",
				"caperun": "animation.cape_illager.run",
				"controllercaperun": "controller.animation.cape.running",
				"hold_gun": "animation.repillager.hold_gun",
				"onehand": "animation.pillager.onehand.hold"
			},
			"render_controllers": [
				"controller.render.vanilla.biome",
				"controller.render.villager.armor",
				"controller.render.villager.cape"
			],
			"enable_attachables": true,
			"hide_armor": true
		}
	}
}