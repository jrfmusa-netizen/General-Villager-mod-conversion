{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "fv:copper_golem",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/copper_golem/copper_golem",
				"target": "textures/entity/target"
			},
			"geometry": {
				"default": "geometry.copper_golem",
				"target": "geometry.target"
			},
			"animations": {
				"stand": "animation.copper_golem.stand",
				"attack": "animation.copper_golem.attack",
				"look_at_target": "animation.humanoid.look_at_target.default",
				"attacking": "controller.animation.copper.golem.attack",
				"hide": "animation.target.default",
				"show": "animation.target.pop",
				"walking": "animation.copper_golem.walking"
			},
			"scripts": {
				"pre_animation": [
					"variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
				],
				"animate": [
					"walking",
					"attacking",
					"look_at_target",
					{
						"hide": "!query.is_sheared"
					},
					{
						"show": "query.is_sheared"
					},
					{
						"stand": "query.is_sitting"
					}
				]
			},
			"render_controllers": [
				"controller.render.iron_golem_tamed",
				"controller.render.golem.target"
			],
			"spawn_egg": {
				"texture": "copper_golem"
			}
		}
	}
}