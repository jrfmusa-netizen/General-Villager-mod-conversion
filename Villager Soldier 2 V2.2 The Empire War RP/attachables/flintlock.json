{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "flintlock:crossbow",
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/musket/flintlock",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.flintlock"
			},
			"animations": {
				"wield": "animation.musket.wield",
				"wield_first_person_pull": "animation.musket.pull",
				"tpp": "animation.musket.tpp"
			},
			"scripts": {
				"pre_animation": [
					"variable.charge_amount = math.clamp((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / 10.0, 0.0, 1.0f);"
				],
				"animate": [
					{
						"wield": "!query.main_hand_item_use_duration && c.is_first_person"
					},
					{
						"wield_first_person_pull": "query.main_hand_item_use_duration > 0.0f && c.is_first_person"
					},
					{
						"tpp": "!c.is_first_person"
					}
				]
			},
			"render_controllers": [
				"controller.render.musket"
			]
		}
	}
}