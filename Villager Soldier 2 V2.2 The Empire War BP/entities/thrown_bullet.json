{
	"format_version": "1.16.0",
	"minecraft:entity": {
		"description": {
			"identifier": "fv:thrown_bullet",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"runtime_identifier": "snowball",
			"animations": {
				"flintlock": "animation.flintlock.shoot",
				"rifle": "animation.rifle.shoot",
				"mustket": "animation.musket.shoot"
			},
			"scripts": {
				"animate": [
					{
						"flintlock": "query.variant==2"
					},
					{
						"rifle": "query.variant==1"
					},
					{
						"mustket": "query.variant==3"
					}
				]
			}
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {
					"remove_child_entities": false
				}
			},
			"timer": {
				"minecraft:timer": {
					"time": [
						1,
						1
					],
					"time_down_event": {
						"event": "despawn",
						"target": "self"
					}
				}
			},
			"rifle": {
				"minecraft:projectile": {
					"on_hit": {
						"impact_damage": {
							"damage": [
								35,
								40
							],
							"knockback": true,
							"semi_random_diff_damage": false,
							"destroy_on_hit": true
						},
						"stick_in_ground": {
							"shake_time": 0.35
						},
						"arrow_effect": {},
						"definition_event": {
							"affect_projectile": true,
							"event_trigger": {
								"event": "timer",
								"target": "self"
							}
						}
					},
					"power": 20,
					"gravity": 0.1,
					"uncertainty_base": 4,
					"uncertainty_multiplier": 1,
					"anchor": 1,
					"should_bounce": true,
					"offset": [
						0,
						-0.2,
						0
					],
					"liquid_inertia": 0.8
				}
			},
			"flintlock": {
				"minecraft:projectile": {
					"on_hit": {
						"impact_damage": {
							"damage": [
								25,
								30
							],
							"knockback": true,
							"semi_random_diff_damage": false,
							"destroy_on_hit": true
						},
						"stick_in_ground": {
							"shake_time": 0.35
						},
						"arrow_effect": {},
						"definition_event": {
							"affect_projectile": true,
							"event_trigger": {
								"event": "timer",
								"target": "self"
							}
						}
					},
					"power": 25,
					"gravity": 0.1,
					"uncertainty_base": 6,
					"uncertainty_multiplier": 1,
					"anchor": 1,
					"should_bounce": true,
					"offset": [
						0,
						-0.2,
						0
					],
					"liquid_inertia": 0.8
				}
			},
			"flintlocksound": {
				"minecraft:variant": {
					"value": 2
				}
			},
			"riflesound": {
				"minecraft:variant": {
					"value": 1
				}
