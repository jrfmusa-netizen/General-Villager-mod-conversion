			"minecraft:entity_spawned": {
				"sequence": [
					{
						"filters": {
							"test": "has_equipment",
							"subject": "other",
							"operator": "==",
							"value": "rifle:crossbow"
						},
						"add": {
							"component_groups": [
								"rifle",
								"riflesound"
							]
						}
					},
					{
						"filters": {
							"test": "has_equipment",
							"subject": "other",
							"operator": "==",
							"value": "flintlock:crossbow"
						},
						"add": {
							"component_groups": [
								"flintlock",
								"flintlocksound"
							]
						}
					},
					{
						"filters": {
							"test": "has_equipment",
							"subject": "other",
							"operator": "==",
							"value": "mustket:crossbow"
						},
						"add": {
							"component_groups": [
								"musketsound"
							]
						}
					},
					{
						"filters": {
							"test": "has_equipment",
							"subject": "other",
							"operator": "==",
							"value": "pirate:crossbow"
						},
						"add": {
							"component_groups": [
								"flintlocksound"
							]
						}
					}
				]
			},
			"despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
